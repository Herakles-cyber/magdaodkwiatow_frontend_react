	"compilerOptions": {
		"target": "es2016",
		"module": "commonjs",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"baseUrl": ".", // ← dodane
		"paths": {
			// ← dodane
			"@/*": ["src/*"]
		}
	},
	"include": ["src"]
